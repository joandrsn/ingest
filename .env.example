# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ingest
DB_USER=postgres
DB_PASSWORD=your_password_here

# API Endpoints (optional - defaults are provided)
ELOVERBLIK_BASE_URL=https://api.eloverblik.dk/customerapi/api
TECHEM_BASE_URL=https://techemadmin.dk/analytics/graphql
ENERGIDATASERVICE_BASE_URL=https://api.energidataservice.dk

# ConnectedCars: the brand app of the account (minvolkswagen, minskoda, minseat, mitaudi)
CONNECTEDCARS_NAMESPACE=minvolkswagen
# Only used by probe_connectedcars.py; the provider reads its login from the database
CONNECTEDCARS_EMAIL=
CONNECTEDCARS_PASSWORD=

# Logging Configuration
LOG_LEVEL=INFO
